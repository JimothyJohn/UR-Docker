# UR-Docker environment — copy to `.env` and edit for your setup.
# `.env` is gitignored; never commit real credentials here.
#
# Everything defaults to the local URSim container, so for the simulator you
# don't need this file at all. Set these only when pointing the toolkit at a
# different host (e.g. a real e-Series controller on your network).

# --- Connection target -------------------------------------------------------
# Controller host or IP (default: localhost — the URSim container)
# UR_HOST=192.168.1.50

# Dashboard server port (default: 29999)
# UR_DASH_PORT=29999

# Primary Client port — state broadcast + URScript execution (default: 30001)
# UR_PRIMARY_PORT=30001

# Socket timeout in seconds (default: 10)
# UR_TIMEOUT_S=10

# Controller software platform: e-series (default) or polyscopex
# UR_PLATFORM=e-series
# PolyScope X Robot-API HTTP port (the sim publishes it on 8000)
# UR_ROBOT_API_PORT=8000

# --- Observability -----------------------------------------------------------
# If set, append a JSON-lines audit record per action to this file.
# UR_AUDIT_LOG=/tmp/ur-audit.jsonl

# --- Credentials (real-robot file transfer only) -----------------------------
# `urctl guided --live-scp` and manual scp use SSH to drop programs into
# /programs/ on a real e-Series. The password is read from $SSHPASS at runtime
# and is NEVER written to argv or committed. Prefer `ssh-copy-id root@<ip>` and
# leave this unset. The default `root` login is the manufacturer default,
# documented by Universal Robots.
# SSHPASS=
