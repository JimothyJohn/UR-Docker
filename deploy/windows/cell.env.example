# Your cell, for the Docker cockpit on Windows (docker-compose.windows.yml).
# Copy to deploy\windows\<name>.env (git-ignored), edit, then:
#
#   powershell -ExecutionPolicy Bypass -File scripts\docker-windows.ps1 -Cell <name> -Lan
#
# Plain KEY=VALUE, only UR_* / PERCEPTRONICS_* / REALSENSE_* names (perceptronics/cell.py
# refuses anything else). The values below are the UR3e cell's (perceptronics/cells/ur3.env)
# minus what is particular to Nick's bench: his hand-eye solve and his two webcams.
#
# The controller's IP (pendant: Settings -> System -> Network). This PC needs an address
# on the same subnet.
UR_HOST=
# e-series = PolyScope 5 (Dashboard 29999 / Primary 30001 / RTDE 30004).
# polyscopex = PolyScope X: set UR_ROBOT_API_PORT=80 as well (see cells/ur20.env).
UR_PLATFORM=e-series
UR_DASH_PORT=29999
UR_PRIMARY_PORT=30001
UR_RTDE_PORT=30004
# Sizes the reach fallback and the arm drawing: UR3e, UR5e, UR10e, UR20 ...
UR_ROBOT_MODEL=UR3e
# Which bracket print holds the camera: eseries (ISO-50 flange) or ur20 (clocked 45 deg).
PERCEPTRONICS_BRACKET=eseries
# Flange -> fingertip length along the tool axis, metres. 0.163 is a Hand-E on the 6 mm
# adapter; measure yours - every approach is by the fingertips.
PERCEPTRONICS_TIP_M=0.163
PERCEPTRONICS_APPROACH_REFERENCE=fingertip
PERCEPTRONICS_STANDOFF_M=0.075
# Hand-eye: leave PERCEPTRONICS_T_FLANGE_CAMERA out. Without it the cockpit starts from the
# bracket's nominal seed and then uses captures\calibration\handeye_<name>.json once you
# calibrate (cockpit /classic -> Calibrate hand-eye -> Apply). A line here would win over
# that file, which is how a copied solve from another camera/bracket keeps picks off.
