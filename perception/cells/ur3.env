# Cell profile: the UR3e test cell (ISO-50 flange, `eseries` bracket print).
# PolyScope 5 (e-Series): Dashboard :29999, Primary :30001, RTDE :30004 — no Robot-API.
# Fill in UR_HOST with the controller's IP (Settings -> System -> Network on the pendant).
# Loaded by `--cell ur3` / `UR_CELL=ur3`; a variable already set in the shell wins.
UR_HOST=192.168.3.3
UR_PLATFORM=e-series
UR_DASH_PORT=29999
UR_PRIMARY_PORT=30001
UR_RTDE_PORT=30004
PERCEPTION_BRACKET=eseries
UR_ROBOT_MODEL=UR3e
# Camera (depth frame) pose in the flange frame. Solved 2026-09-23 by the cockpit's
# touch-and-click hand-eye calibration: mark = flange centre on the tape measure,
# 3 clicked views from varied wrist poses, RMS 1.7 mm, no warnings (also saved to
# captures/calibration/handeye_ur3.json; this env line wins over the file).
# Nick's hand measurement was [0,-0.055,0.008,+5deg about X]; the solve moved it
# 21 mm in X, 36 mm in Z and flipped the tilt to -9.5 deg — that was the constant
# ~35 mm landing error. UR pose [x,y,z,rx,ry,rz], metres + rotation vector.
PERCEPTION_T_FLANGE_CAMERA=[-0.021505,-0.058017,-0.027852,-0.165422,0.032409,0.016639]
# Approach: the tool FLANGE sits 75 mm above the top of the object (Nick, 2026-09-23).
# The active TCP on this controller is a 223 mm training offset the physical tool
# doesn't match, so the standoff is measured from the flange, not the TCP.
PERCEPTION_APPROACH_REFERENCE=flange
PERCEPTION_STANDOFF_M=0.075
