# Cell profile: the PolyScope X simulator on this machine (docker compose --profile polyscopex).
# Loaded by `--cell sim` / `UR_CELL=sim`; a variable already set in the shell wins.
UR_HOST=localhost
UR_PLATFORM=polyscopex
UR_ROBOT_API_PORT=8000
UR_PRIMARY_PORT=31001
UR_RTDE_PORT=31004
# No camera in the sim cell: the cockpit runs the synthetic RGB-D scene.
PERCEPTION_FAKE=1
PERCEPTION_BRACKET=eseries
UR_ROBOT_MODEL=UR3
