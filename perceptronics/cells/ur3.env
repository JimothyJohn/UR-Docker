# Cell profile: the UR3e test cell (ISO-50 flange, `eseries` bracket print).
# PolyScope 5 (e-Series): Dashboard :29999, Primary :30001, RTDE :30004 — no Robot-API.
# Fill in UR_HOST with the controller's IP (Settings -> System -> Network on the pendant).
# Loaded by `--cell ur3` / `UR_CELL=ur3`; a variable already set in the shell wins.
UR_HOST=192.168.3.3
UR_PLATFORM=e-series
UR_DASH_PORT=29999
UR_PRIMARY_PORT=30001
UR_RTDE_PORT=30004
PERCEPTRONICS_BRACKET=eseries
UR_ROBOT_MODEL=UR3e
# Camera (depth frame) pose in the flange frame. UR pose [x,y,z,rx,ry,rz], metres +
# rotation vector; this env line wins over captures/calibration/handeye_ur3.json.
#
# 2026-09-25: bracket re-clocked 180 deg about the flange axis (camera now opposite the
# tool connector). Re-solved the same day with the mark-less ORBIT calibration
# (docs/realsense.md "Hand-eye without a mark"): a foam block's top-face centre as the
# unknown mark, 16 views at 0.2/0.3/0.4 m with +-15 deg tilts and +-30 deg yaws,
# RMS 4.4 mm, no warnings (also captures/calibration/handeye_ur3.json; this line wins).
# Camera ~30 mm X / 59 mm Y off the flange axis, 180 deg about Z, ~10 deg tilt.
# Verified by a pick: the Hand-E closed on a 27 mm block (OBJ 2) and lifted it.
# The Rz(pi)-rotated 09-23 solve used as a seed earlier today was 5-10 cm wrong in
# practice: never place from a re-clocked seed, re-solve.
# 2026-09-23 solve (connector side, RMS 1.7 mm): [-0.021505,-0.058017,-0.027852,-0.165422,0.032409,0.016639]
# 2026-09-27 22:40: re-solved with `perceptronics calibrate --apply` (orbit over one block, 28 of
# 39 views, RMS 2.5 mm). The 09-25 solve below had drifted: the floor fitted in the base
# frame tilted 5.3-6.0 deg with it (the table is flat -> calibration error), 1.4-2.2 deg with this.
# 2026-09-25 solve: [0.028647,0.058669,0.012281,0.07665,0.175727,-3.089767]
PERCEPTRONICS_T_FLANGE_CAMERA=[0.013337,0.055303,0.01286,0.099999,-0.1637,3.118758]
# Extra viewpoints under the colour/depth pair (perceptronics.views): the two Logitech
# webcams on the Mac Studio, by AVFoundation name (`ffmpeg -f avfoundation
# -list_devices true -i ""`). Needs ffmpeg; the same names work for dshow on Windows.
PERCEPTRONICS_VIEWS=HD Pro Webcam C920,Logi Webcam C920e
# Lock both webcams' focus (perceptronics.uvc; pick-cycle --record applies it): the C920 on
# continuous autofocus hunted every other second once the warm lamp went in behind it
# (2026-09-27). 0 = far; both scenes are ~1-2 m away and sweep sharpest there.
PERCEPTRONICS_VIEW_FOCUS=0
# Approach by the FINGERTIPS (Nick, 2026-09-27: "always approach with the fingertips,
# the tool offset is critical"): the Hand-E's fingertips sit 75 mm above the top of the
# object, approached along the tool axis, and every cockpit move runs with the TCP set
# to them. The controller's active TCP is a 223 mm training offset the Hand-E doesn't
# match — never used. (09-23 to 09-27 the standoff was from the flange: with the
# Hand-E on, that put the fingertips ~90 mm into the part.)
PERCEPTRONICS_APPROACH_REFERENCE=fingertip
PERCEPTRONICS_STANDOFF_M=0.075
# Flange → fingertip along flange +Z: Hand-E 157 mm + 6 mm bracket adapter (pick-cycle's
# measured tip_m, 2026-09-25).
PERCEPTRONICS_TIP_M=0.163
# Work surface: the parts sit ~0.27 m BELOW the robot base (the 09-25 hand-eye solved the
# block top at base z = -0.270). Reach 0.5 m out at that depth depends on the height and
# tilt — the controller's IK decides (locate's reach_check), not the datasheet radius.
# The picture pose (HOME in the cockpit, POST /api/robot/home; a flange pose, TCP at the
# flange): looking down at the floor in front of the stand, the camera under the tool —
# Nick set it 2026-09-27 22:25 ("perfect for imaging beneath it"): 0.37 m up, every pick sweep starts here.
PERCEPTRONICS_HOME_POSE=[-0.21001,0.10582,0.36730,-2.64383,0.05243,0.11875]
