# The product page's deploy settings. Copy to site/.env (gitignored) and fill in:
#   cp site/.env.example site/.env
# Credentials come from the AWS CLI's own environment; set AWS_PROFILE only to pick one.
AWS_REGION=us-east-1            # CloudFront's certificate must live in us-east-1
AWS_PROFILE=
DOMAIN_NAME=advin.io            # the Route53 zone
SUBDOMAIN=perceptronics         # -> perceptronics.advin.io (also the bucket's name)
HOSTED_ZONE_ID=ZXXXXXXXXXXXXX   # aws route53 list-hosted-zones
STACK_NAME=perceptronics-site
